<?xml version="1.0" encoding="utf-8"?>
<!-- Flat launch splash: brand Paper (or Ink in values-night) plus the
     centred mark. No gradient, no glow, no lockup plate.
     `launch_image.png` is generated by `tool/generate_icons.py` from
     brand/medaix-mark-512.png; the night densities use the dark mark.
     Android 12+ draws the adaptive launcher icon instead; Flutter
     `BootSplash` then shows the lockup on the themed background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
