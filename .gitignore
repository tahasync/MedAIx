# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Python / uv ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ---- Local DB ----
*.db
*.sqlite
*.sqlite3

# ---- Flutter / Dart ----
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/build/
app/.packages
app/.pub-cache/
app/.pub/
app/coverage/

# ---- IDE ----
.idea/
.vscode/
*.iml
*.ipr
*.iws

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Secrets / keys ----
*.jks
*.keystore
*.p12
*.pem
app/android/key.properties
app/android/app/keystore.jks

# ---- Local logs & verification artifacts ----
# Written by local dev/test shells; never part of the repo.
server.log
*.log
app/*.log
app/shot_*.png
package.txt

# ---- Icon generator scratch ----
# `tool/out` holds design contact sheets from `tool/generate_icons.py --preview`.
tool/out/
.neon

# ---- Neon CLI / agent skills (local tooling) ----
# .neon holds link state; .env.local is already covered by .env.*.
node_modules/
package.json
package-lock.json
skills-lock.json
# neon.ts is generated by `neon link`/`neon deploy` and currently only wraps an
# empty defineConfig({}), so there is nothing in it worth versioning.
neon.ts
# .agents/ is vendored Neon agent skills, restored by `neon skills -s neon -y`.
# It is ~0.3 MB of upstream docs that change on their own release schedule, so
# tracking it here would only create churn.
.agents/
